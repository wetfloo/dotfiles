model = "gpt-6.1-sol"
model_reasoning_effort = "xhigh"
service_tier = "default"

[tui]
screen_reader_detection_done = true
session_picker_view = "dense"
agents_overview_grouping = "project"
theme = "coldark-dark"
status_line = ["thread-name", "model-with-reasoning", "run-state", "branch-changes", "git-branch", "task-progress", "five-hour-limit", "weekly-limit"]
status_line_use_colors = true

[tui.keymap.approval]
decline = "n"

[tui.keymap.chat]
interrupt_turn = "ctrl-q"

[marketplaces.ponytail]
source_type = "git"
source = "https://github.com/DietrichGebert/ponytail.git"

[plugins."ponytail@ponytail"]
enabled = true

[features]
hooks = true

[shell_environment_policy.set]
GIT_AUTHOR_NAME = "Codex"
GIT_AUTHOR_EMAIL = "noreply@openai.com"
GIT_COMMITTER_NAME = "Codex"
GIT_COMMITTER_EMAIL = "noreply@openai.com"
