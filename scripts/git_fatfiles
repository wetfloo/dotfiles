#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

# distantly based on the original answer at https://stackoverflow.com/questions/1029969/why-is-my-git-repository-so-big/45366030#45366030

usage() {
	cat <<'USAGE'
Usage: git_fatfiles [--directories] [--[no]sum|-s] [--[no]deleted] [--[no]units|-u]

Show compressed on-disk blob sizes across all Git history, smallest first.
  --directories  Aggregate by immediate parent directory (root files use .).
  --nosum        Show the largest object per path instead of summing versions.
  --deleted      Only include paths absent from the working tree.
  --nodeleted    Only include paths present in the working tree.
  --nounits      Print bytes instead of human-readable units.
  --help, -h     Show this help, including outside a repository.

Defaults: --sum --units. Identical blobs are counted once, under one path.
USAGE
}

sum=1
directories=0
deleted=all
units=1
for argument in "$@"; do
	case $argument in
		--sum|-s) sum=1 ;;
		--nosum|--no-sum) sum=0 ;;
		--directories) directories=1 ;;
		--deleted) deleted=1 ;;
		--nodeleted|--no-deleted) deleted=0 ;;
		--units|-u) units=1 ;;
		--nounits|--no-units) units=0 ;;
		--help|-h) usage; exit 0 ;;
		*) printf 'Unknown argument: %s\n' "$argument" >&2; usage >&2; exit 1 ;;
	esac
done

repo_root=$(git rev-parse --show-toplevel)
cd -- "$repo_root"

# shortcut: rev-list provides one path per blob and strips newlines; use tree traversal for exact path attribution.
# Prefix paths so cat-file preserves leading whitespace in its "rest" field.
git rev-list --all --objects |
	sed 's/ / .\//' |
	git cat-file --buffer --batch-check='%(objecttype) %(objectsize:disk) %(rest)' |
	while IFS= read -r record; do
		[[ $record == blob\ * ]] || continue
		record=${record#blob }
		size=${record%% *}
		path=${record#* ./}
		if [[ $deleted == 1 && ( -e $path || -L $path ) ]]; then
			continue
		fi
		if [[ $deleted == 0 && ! -e $path && ! -L $path ]]; then
			continue
		fi
		if [[ $directories == 1 ]]; then
			if [[ $path == */* ]]; then
				path=${path%/*}
			else
				path=.
			fi
		fi
		printf '%s\t%s\n' "$size" "$path"
	done |
	awk -F '\t' -v sum="$sum" '
		{
			path = substr($0, index($0, "\t") + 1)
			if (sum) sizes[path] += $1
			else if (!(path in sizes) || $1 > sizes[path]) sizes[path] = $1
		}
		END {
			for (path in sizes) printf "%.0f\t%s\n", sizes[path], path
		}' |
	sort -n |
	awk -F '\t' -v units="$units" '
		BEGIN { split("B KiB MiB GiB TiB PiB EiB", labels, " ") }
		!units { print; next }
		{
			size = $1
			path = substr($0, index($0, "\t") + 1)
			unit = 1
			while (size >= 1024 && unit < 7) { size /= 1024; unit++ }
			printf (unit == 1 ? "%.0f %s\t%s\n" : "%.1f %s\t%s\n"), size, labels[unit], path
		}'
