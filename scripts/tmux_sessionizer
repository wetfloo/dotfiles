#!/usr/bin/env bash

set -euo pipefail

if [[ $# -gt 0 ]]; then
	selected=$1
else
	selected=$(
		for directory in "$HOME/Projects"/*/ "$HOME/.codex/worktrees"/*/*/; do
			[[ -d $directory ]] || continue
			printf '%s\0' "$directory"
		done | fzf --read0 --no-multi --scheme path
	) || {
		status=$?
		[[ $status == 1 || $status == 130 ]] && exit 0
		exit "$status"
	}
fi

if [[ -z $selected ]]; then
	exit 0
fi

exec tmux_join "$selected"
