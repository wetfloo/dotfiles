#!/usr/bin/env bash

set -euo pipefail

if [[ $# -gt 0 ]]; then
	selected=$1
else
	selected=$(
		for root in "$HOME/Projects" "$HOME/Documents/Projects" "$HOME/Documents/dotfiles"; do
			for directory in "$root"/*/; do
				[[ -d $directory ]] || continue
				printf '%s\0' "$directory"
			done
		done | fzf --read0 --no-multi --scheme path
	) || {
		status=$?
		[[ $status == 1 || $status == 130 ]] && exit 0
		exit "$status"
	}
fi

if [[ -z $selected ]]; then
	exit 0
fi

exec tmux_join "$selected"
