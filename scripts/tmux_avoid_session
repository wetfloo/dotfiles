#!/usr/bin/env bash

set -euo pipefail

index=$(
	{ tmux list-sessions -F '#{session_name}' 2>/dev/null || :; } |
		awk '/^tmux_sessionizer[0-9]+$/ {
			sub(/^tmux_sessionizer/, "")
			if ($0 + 0 >= next_index) next_index = $0 + 1
		} END { printf "%.0f\n", next_index + 0 }'
)
session=tmux_sessionizer$index

if [[ -n ${TMUX:-} ]]; then
	tmux new-session -d -s "$session" tmux_sessionizer
	exec tmux switch-client -t "=$session"
else
	exec tmux new-session -s "$session" tmux_sessionizer
fi
