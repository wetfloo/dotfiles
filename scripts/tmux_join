#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 || -z $1 ]]; then
	printf 'Usage: tmux_join DIRECTORY\n' >&2
	exit 1
fi

directory=$(CDPATH= cd -- "$1" && printf '%s/' "$PWD")
directory=${directory%/}
selected_name=${directory##*/}
selected_name=${selected_name//[.:]/_}

# "/" selects a plain session rooted at home.
if [[ $directory == / ]]; then
	selected_name=/
	directory=$HOME
fi

if ! tmux has-session -t "=$selected_name" 2>/dev/null; then
	tmux new-session -d -s "$selected_name" -c "$directory"
	if [[ $selected_name != / ]]; then
		# Window IDs keep the preset independent of base-index and renumbering.
		editor=$(tmux new-window -d -b -P -F '#{window_id}' -t "=$selected_name:^" -c "$directory")
		git_window=$(tmux new-window -d -a -P -F '#{window_id}' -t "$editor" -c "$directory")
		tmux send-keys -t "$editor" 'nvim .' Enter
		tmux send-keys -t "$git_window" lazygit Enter
	fi
fi

if [[ -n ${TMUX:-} ]]; then
	exec tmux switch-client -t "=$selected_name"
else
	exec tmux attach-session -t "=$selected_name"
fi
